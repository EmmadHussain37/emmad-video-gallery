# ==============================================================================
# Git Ignore for Emmad Video Gallery (WordPress Plugin)
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor & IDE configurations
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-project
*.sublime-workspace

# Build artifacts & package archives
*.zip
*.tar
*.gz
*.rar
*.7z
dist/
build/

# Dependency directories
node_modules/
vendor/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.backup
*.old
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and sensitive data
.env
.env.*
*.local

# WordPress core and upload paths (if cloned in full WP tree)
wp-config.php
wp-load.php
wp-blog-header.php
wp-cron.php
wp-login.php
wp-mail.php
wp-settings.php
wp-signup.php
wp-trackback.php
xmlrpc.php
/wp-admin/
/wp-includes/
/wp-content/uploads/
/wp-content/blogs.dir/
/wp-content/upgrade/
/wp-content/backup-db/
/wp-content/advanced-cache.php
/wp-content/wp-cache-config.php
/wp-content/cache/
